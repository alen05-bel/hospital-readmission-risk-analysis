-- Finding 2. Does a medication change at discharge affect readmission?

SELECT
	`change`,
    COUNT(*) AS total_encounter,
    ROUND(SUM(readmitted = '<30') / COUNT(*) * 100, 1) AS readmission_rate_pct
FROM diabetic_data_dedup
GROUP BY `change`;


-- Finding 3. Discharge disposition impact
-- groups patients by their post-discharge destination to calculate their 30-day readmission rate and see where patient risk is highest
SELECT
	description AS discharge_disposition,
    COUNT(*) total_encounters,
    ROUND(SUM(readmitted = '<30') / COUNT(*) * 100, 1) AS readmission_rate_pct
FROM diabetic_data_dedup a
JOIN discharge_disposition_map b
ON a.discharge_disposition_id = b.discharge_disposition_id
GROUP BY discharge_disposition
HAVING total_encounters > 100         -- filtering out categories with too few encounters to be statistically meaningful
ORDER BY readmission_rate_pct DESC
LIMIT 10;



-- Finding 4. A1C testing and readmission
-- groups patients by their A1C test result to calculate their 30-day readmission rates
SELECT
	A1Cresult,
    COUNT(*) AS total_encounters,
    ROUND(SUM(readmitted = '<30') / COUNT(*) * 100, 1) AS readmission_rate_pct
FROM diabetic_data_dedup
GROUP BY A1Cresult;

    













